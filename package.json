{
  "name": "estimator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first PWA for trades estimating + lead organizing (painting / handyman / general).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
