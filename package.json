    "test:watch": "vitest",
    "gen-icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "pdfmake": "^0.2.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pdfmake": "^0.2.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.5"
